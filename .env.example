APP_NAME="Kaldis Coffee Strategic Planning & Performance System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Addis_Ababa
APP_URL=https://planner.kaldisbunnaet.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kaldisbp_planner
DB_USERNAME=kaldisbp_planner_user
DB_PASSWORD=your_password_here

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
CACHE_PREFIX=kaldis_planner_

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kaldiscoffee.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kaldis Specific Configuration
KALDIS_PLANNING_YEAR="2019 E.C."
KALDIS_PLANNING_MONTH="Meskerem"
KALDIS_WEEKLY_DEADLINE_DAY="Monday"
KALDIS_WEEKLY_DEADLINE_TIME="12:00"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="KaldisPlannerBot"
